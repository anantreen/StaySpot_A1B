# Project-specific host ports avoid native services and the separate StaySpotAI app.
# Sample local credentials only; copy to .env and adjust for your own machine.
# DATABASE_URL is read by the API, psql and PostgreSQL/Python seeders.
DATABASE_URL=postgresql://stayspot:stayspot@127.0.0.1:55434/stayspot
# MONGO_URL selects the MongoDB server; MONGO_DB selects its logical database.
MONGO_URL=mongodb://127.0.0.1:27021
MONGO_DB=stayspot
# Compose host ports must also match DATABASE_URL / MONGO_URL when overridden.
POSTGRES_PORT=55434
MONGO_PORT=27021
# HTTP listener used by npm start; the development UI proxies to this server.
PORT=3000
